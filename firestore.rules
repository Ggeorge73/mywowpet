rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasOnlyAllowedUserFields() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'email',
        'createdAt',
        'updatedAt',
        'profile',
        'pets',
        'cart',
        'wishlist',
        'gameHighScore',
        'streak'
      ]);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && hasOnlyAllowedUserFields();
      allow update: if isOwner(userId)
        && hasOnlyAllowedUserFields()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid',
          'email',
          'createdAt'
        ]);
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.productId is int
        && request.resource.data.productId >= 1
        && request.resource.data.productId <= 999999
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000;
      allow update, delete: if false;
    }

    match /orders/{orderId} {
      allow read, write: if false;
    }

    match /loyalty/{docId} {
      allow read, write: if false;
    }

    match /subscriptions/{docId} {
      allow read, write: if false;
    }

    match /launchSignups/{signupId} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly([
          'email',
          'petType',
          'consent',
          'source',
          'offer',
          'createdAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.petType in [
          'not-specified',
          'dog',
          'cat',
          'dog-and-cat',
          'small-pet',
          'bird',
          'other'
        ]
        && request.resource.data.consent == true
        && request.resource.data.source == 'coming-soon'
        && request.resource.data.offer == 'launch-15'
        && request.resource.data.createdAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
