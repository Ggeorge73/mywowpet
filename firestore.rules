rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasOnlyAllowedUserFields() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'email',
        'createdAt',
        'updatedAt',
        'profile',
        'pets',
        'cart',
        'wishlist',
        'gameHighScore',
        'streak'
      ]);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && hasOnlyAllowedUserFields();
      allow update: if isOwner(userId)
        && hasOnlyAllowedUserFields()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid',
          'email',
          'createdAt'
        ]);
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // Reviews are public and rendered on product pages, so every field is typed
      // and size-capped. Doc id is `${uid}_${productId}`: one review per user per product.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'id',
          'productId',
          'author',
          'rating',
          'text',
          'pet',
          'date',
          'avatar',
          'userId',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'id',
          'productId',
          'author',
          'rating',
          'text',
          'userId',
          'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == reviewId
        && reviewId == request.auth.uid + '_' + string(request.resource.data.productId)
        && request.resource.data.productId is int
        && request.resource.data.productId >= 1
        && request.resource.data.productId <= 999999
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.author is string
        && request.resource.data.author.size() >= 1
        && request.resource.data.author.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 2000
        && (!('pet' in request.resource.data)
          || (request.resource.data.pet is string && request.resource.data.pet.size() <= 60))
        && (!('date' in request.resource.data)
          || (request.resource.data.date is string
            && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('avatar' in request.resource.data)
          || (request.resource.data.avatar is string
            && request.resource.data.avatar.size() <= 16
            && request.resource.data.avatar.matches('^[^<>&"]*$')))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /orders/{orderId} {
      allow read, write: if false;
    }

    match /loyalty/{docId} {
      allow read, write: if false;
    }

    match /subscriptions/{docId} {
      allow read, write: if false;
    }

    match /launchSignups/{signupId} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly([
          'email',
          'petType',
          'consent',
          'source',
          'offer',
          'createdAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.petType in [
          'not-specified',
          'dog',
          'cat',
          'dog-and-cat',
          'small-pet',
          'bird',
          'other'
        ]
        && request.resource.data.consent == true
        && request.resource.data.source in ['coming-soon', 'footer']
        && request.resource.data.offer == 'launch-15'
        && request.resource.data.createdAt == request.time;
    }

    // Contact-form messages: anyone may create one, nobody can read, edit or delete
    // them from a client (support reads them with admin access). Every field is typed
    // and size-capped so the collection cannot be used as free storage.
    match /contactMessages/{messageId} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly([
          'name',
          'email',
          'subject',
          'message',
          'orderNumber',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name',
          'email',
          'subject',
          'message',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 1
        && request.resource.data.subject.size() <= 150
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 5000
        && (!('orderNumber' in request.resource.data)
          || (request.resource.data.orderNumber is string
            && request.resource.data.orderNumber.size() <= 40))
        && request.resource.data.createdAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
